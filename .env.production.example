# ============================================================
# Karir.ai — production environment (EXAMPLE)
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Nilai di sini dibaca oleh docker compose, lalu diteruskan ke container.
# Jangan pernah commit .env.production.
#
# Semua secret di-generate sendiri, satu per baris:
#   openssl rand -base64 32
# ============================================================

# ------------------------------------------------------------
# Image tag — naikkan tiap rilis supaya rollback tinggal ganti angka.
# ------------------------------------------------------------
IMAGE_TAG=latest

# ------------------------------------------------------------
# Database (internal ke docker network, tidak diekspos ke host)
# ------------------------------------------------------------
POSTGRES_USER=karirku
POSTGRES_DB=karirku
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Aplikasi web
# ------------------------------------------------------------
# Port di host. Default hanya listen di loopback — TLS diterminasi oleh
# reverse proxy (Caddy/Nginx) di depannya. Ganti WEB_BIND ke 0.0.0.0 hanya
# kalau memang tidak ada proxy.
WEB_BIND=127.0.0.1
WEB_PORT=3030

# Harus https dan sama persis dengan domain publik — dipakai callback OAuth.
NEXTAUTH_URL=https://karir.ai
# openssl rand -base64 32
NEXTAUTH_SECRET=

# GitHub OAuth App — callback: https://karir.ai/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------
# Secrets engine — WAJIB, dan harus dua nilai yang BERBEDA.
# Mengganti OAUTH_TOKEN_ENCRYPTION_KEY membuat semua token OAuth yang
# tersimpan tidak bisa didekripsi lagi; user harus connect ulang.
# ------------------------------------------------------------
OAUTH_TOKEN_ENCRYPTION_KEY=
AUTOFILL_TOKEN_SECRET=

# ------------------------------------------------------------
# Google OAuth (Gmail outcome assistant, scope gmail.readonly)
# Redirect URI: https://karir.ai/api/auth/gmail/callback
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# Object storage (MinIO di stack ini; isi endpoint S3 asli kalau pakai cloud)
# ------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=karirku
S3_ACCESS_KEY=karirku
# openssl rand -base64 32
S3_SECRET_KEY=

# ------------------------------------------------------------
# AI
#   ollama = self-host | github = GitHub Models | auto = ollama lalu fallback
#
# Model 27B butuh GPU. Tanpa GPU: arahkan OLLAMA_BASE_URL ke mesin lain,
# atau pakai AI_PROVIDER=github.
# ------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
AI_MODEL_LLM=gemma3:27b
AI_MODEL_FAST=qwen2.5:7b-instruct
AI_MODEL_EMBED=nomic-embed-text
# PAT fine-grained dengan permission "Models: read"
GITHUB_MODELS_TOKEN=

# ------------------------------------------------------------
# Opsional
# ------------------------------------------------------------
NEWSLETTER_WEBHOOK_URL=
FIRECRAWL_SERVICE_URL=
AUTOFILL_USE_LLM=
RECOMMENDATION_DISPLAY_VERSION=v1
RECOMMENDATION_SHADOW_SAMPLE_RATE=0.2

# Hunter adalah alat satu-operator (profil, cover letter, dan sesi browser milik
# satu orang). Set ke email pemiliknya agar admin lain tidak bisa membaca riwayat
# lamaran dan email pribadi tersebut. Kosong = jatuh kembali ke admin-only.
HUNTER_OWNER_EMAIL=
