{
  "name": "@devnolife/karirku-core",
  "version": "0.1.0",
  "description": "Karirku engine: LLM, OCR, matching, scraping, queues, workers and data access. Framework-agnostic — no Next.js, no React.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devnolife/karirku-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.11"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "hunter",
    "prisma",
    "generated",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./workers": {
      "types": "./dist/workers/index.d.ts",
      "default": "./dist/workers/index.js"
    },
    "./autofill/adapters": {
      "types": "./dist/autofill/adapters/index.d.ts",
      "default": "./dist/autofill/adapters/index.js"
    },
    "./scraper/providers": {
      "types": "./dist/scraper/providers/index.d.ts",
      "default": "./dist/scraper/providers/index.js"
    },
    "./prisma": {
      "types": "./generated/prisma/index.d.ts",
      "default": "./generated/prisma/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/applications/*.test.ts tests/autofill/*.test.ts tests/content/*.test.ts tests/match/*.test.ts tests/scraper/*.test.ts",
    "worker": "tsx watch src/workers/index.ts",
    "worker:start": "node dist/workers/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "scan": "tsx scripts/scan.ts",
    "market:intel": "tsx scripts/market-intel.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "match:check": "tsx scripts/match-check.ts",
    "embed:all": "tsx scripts/embed-all.ts",
    "ingest:live": "tsx scripts/ingest-live.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.74.1",
    "crawlee": "^3.16.0",
    "googleapis": "^173.0.0",
    "ioredis": "^5.10.1",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "playwright-core": "^1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.47.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "better-sqlite3"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
