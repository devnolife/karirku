# ============================================================
# Karir.ai (web) — Environment Variables (EXAMPLE)
# Copy ke .env.local dan isi nilai yang sesungguhnya.
# Jangan commit .env.local ke git.
# ============================================================
#
# Repo ini mengembed @devnolife/karirku-core dalam proses yang sama, jadi
# variabel milik engine tetap harus tersedia di sini. Sumber kebenarannya
# ada di .env.example repo karirku-core — jaga keduanya tetap sinkron.
#
#   [WEB]  hanya dipakai aplikasi Next.js ini
#   [CORE] dimiliki engine; nilainya harus sama dengan yang dipakai worker
#

# ------------------------------------------------------------
# [WEB] Next.js / Auth.js
# ------------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3030"

# GitHub OAuth — https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: http://localhost:3030/api/auth/github/callback
# Scope yang diminta hanya read:user + user:email (tanpa akses repo privat).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Opsional: kirim pendaftar newsletter ke webhook eksternal.
NEWSLETTER_WEBHOOK_URL=""

# Pakai LLM untuk menyusun jawaban autofill (default: heuristik saja).
AUTOFILL_USE_LLM=""

# 0..1; production default di kode = 0.2.
RECOMMENDATION_SHADOW_SAMPLE_RATE="0.2"

# ------------------------------------------------------------
# [CORE] Database — schema & migrations dimiliki karirku-core
# ------------------------------------------------------------
DATABASE_URL="postgresql://karirku:karirku@localhost:5432/karirku?schema=public"

# ------------------------------------------------------------
# [CORE] Redis (BullMQ + cache)
# ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------
# [CORE] AI (Ollama lokal untuk dev; ganti ke vLLM endpoint di prod)
# ------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434/v1"
# API key wajib diisi tapi value tidak dipakai Ollama
OLLAMA_API_KEY="ollama"

# LLM = tugas berkualitas tinggi (kuis verifikasi skill, generasi konten).
# FAST = tugas ringan/volume tinggi (ekstraksi skill). EMBED = embedding 768d.
AI_MODEL_LLM="gemma3:27b"
AI_MODEL_FAST="qwen2.5:7b-instruct"
AI_MODEL_EMBED="nomic-embed-text"

# ------------------------------------------------------------
# [WEB] Modul ai/ — pemilihan provider LLM
#   ollama = Ollama lokal (default) | github = GitHub Models |
#   auto   = coba ollama dulu, fallback ke github saat gagal connect
# ------------------------------------------------------------
AI_PROVIDER="auto"
# PAT fine-grained dengan permission "Models: read" — https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=""
GITHUB_MODEL_LLM="openai/gpt-4o"
GITHUB_MODEL_FAST="openai/gpt-4o-mini"

# ------------------------------------------------------------
# [CORE] OCR & scraping
# ------------------------------------------------------------
TESSERACT_BIN="tesseract"
FIRECRAWL_SERVICE_URL="http://localhost:8000"

# ------------------------------------------------------------
# [CORE] Gmail outcome assistant (scope gmail.readonly)
# Authorized redirect URI: http://localhost:3030/api/auth/gmail/callback
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate dua secret berbeda: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=""
AUTOFILL_TOKEN_SECRET=""

# ------------------------------------------------------------
# [CORE] Hunter — state dibagi antara web (baca) dan engine (tulis),
# jadi arahkan ke direktori yang sama di kedua repo.
# ------------------------------------------------------------
HUNTER_DATA_DIR="./data"
HUNTER_DB="./data/hunter.db"
HUNTER_SECRETS_DIR="./secrets"

# ------------------------------------------------------------
# [CORE] Object Storage (MinIO, S3-compatible)
# ------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="karirku"
S3_SECRET_KEY="karirku-dev-secret"
S3_BUCKET="karirku"

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
# V2 default shadow; ubah ke "v2" hanya setelah gate metrik terpenuhi.
RECOMMENDATION_DISPLAY_VERSION="v1"

# ------------------------------------------------------------
# [CORE] Control API — hanya dipakai kalau engine dijalankan di
# mesin lain dan dikendalikan lewat HTTP (`pnpm serve` di karirku-core).
# Kalau engine satu mesin dengan web app, biarkan kosong.
# ------------------------------------------------------------
CORE_URL="http://127.0.0.1:4310"
CORE_API_KEY=""

HUNTER_OWNER_EMAIL=
