# ============================================================
# Karir.ai — Environment Variables (EXAMPLE)
# Copy ke .env.local dan isi nilai yang sesungguhnya.
# Jangan commit .env.local ke git.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://karirku:karirku@localhost:5432/karirku?schema=public"

# --- Redis (BullMQ + cache) ---
REDIS_URL="redis://localhost:6379"

# --- Object Storage (MinIO, S3-compatible) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="karirku"
S3_SECRET_KEY="karirku-dev-secret"
S3_BUCKET="karirku"

# --- Next.js / Auth.js ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth untuk Gmail outcome assistant (scope gmail.readonly).
# Authorized redirect URI: http://localhost:3000/api/auth/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate dua secret berbeda: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=""
AUTOFILL_TOKEN_SECRET=""

# GitHub OAuth — https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
# Scope yang diminta hanya read:user + user:email (tanpa akses repo privat).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Firecrawl service lokal (~/firecrawl-project, FastAPI wrapper) — untuk
# scrape career pages perusahaan tanpa JSON API (provider: "firecrawl").
FIRECRAWL_SERVICE_URL="http://localhost:8000"

# --- AI (Ollama lokal untuk dev; ganti ke vLLM endpoint di prod) ---
# OpenAI-compatible API base
OLLAMA_BASE_URL="http://localhost:11434/v1"
# API key wajib diisi tapi value tidak dipakai Ollama
OLLAMA_API_KEY="ollama"

# Model yang dipakai (pastikan sudah `ollama pull`)
# LLM = tugas berkualitas tinggi (kuis verifikasi skill, generasi konten).
# FAST = tugas ringan/volume tinggi (ekstraksi skill). EMBED = embedding 768d.
AI_MODEL_LLM="gemma3:27b"
AI_MODEL_FAST="qwen2.5:7b-instruct"
AI_MODEL_EMBED="nomic-embed-text"

# --- App ---
NODE_ENV="development"
LOG_LEVEL="info"
# V2 default shadow; ubah ke "v2" hanya setelah gate metrik terpenuhi.
RECOMMENDATION_DISPLAY_VERSION="v1"
# 0..1; production default di kode = 0.2.
RECOMMENDATION_SHADOW_SAMPLE_RATE="0.2"
