# ============================================================
# @devnolife/karirku-core — Environment Variables (EXAMPLE)
# Copy to .env / .env.local and fill in real values.
# ============================================================
# Every variable below is read by the engine itself. The web app
# (devnolife/karirku) embeds this package in-process, so it needs the
# same values — keep the two .env files in sync, or source one file.

# --- Database (owned by this package: schema, migrations, seed) ---
DATABASE_URL="postgresql://karirku:karirku@localhost:5432/karirku?schema=public"

# --- Redis (BullMQ queues + cache) ---
REDIS_URL="redis://localhost:6379"

# --- AI (Ollama locally; point at vLLM in production) ---
OLLAMA_BASE_URL="http://localhost:11434/v1"
# Required by the OpenAI-compatible client; Ollama ignores the value.
OLLAMA_API_KEY="ollama"

# LLM  = high-quality work (skill quizzes, content generation)
# FAST = light, high-volume work (skill extraction)
# EMBED = 768-dimension embeddings — must match the pgvector column width
AI_MODEL_LLM="gemma3:27b"
AI_MODEL_FAST="qwen2.5:7b-instruct"
AI_MODEL_EMBED="nomic-embed-text"

# --- OCR ---
TESSERACT_BIN="tesseract"

# --- Scraping ---
FIRECRAWL_SERVICE_URL="http://localhost:8000"

# --- Gmail outcome assistant (scope: gmail.readonly) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Secrets (generate separately: openssl rand -base64 32) ---
OAUTH_TOKEN_ENCRYPTION_KEY=""
AUTOFILL_TOKEN_SECRET=""

# --- Hunter engine ---
# Hunter state must NOT live inside node_modules — a reinstall would wipe it.
# Point these at a durable directory shared by the web app and the engine.
HUNTER_DATA_DIR="./data"
HUNTER_DB="./data/hunter.db"
HUNTER_SECRETS_DIR="./secrets"
# Optional: attach to an existing Chrome instead of launching one.
HUNTER_CHROME=""
HUNTER_PROFILE=""
HUNTER_CDP_PORT="9222"

# --- Object Storage (MinIO, S3-compatible; defined in docker-compose.yml) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="karirku"
S3_SECRET_KEY="karirku-dev-secret"
S3_BUCKET="karirku"

# --- Misc ---
NODE_ENV="development"
RECOMMENDATION_DISPLAY_VERSION="v1"
