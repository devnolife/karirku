// CraftWorks - Prisma Schema
// Sumber kebenaran: docs/superpowers/specs/2026-06-14-craftworks-career-studio-design.md
//
// Catatan:
// - pgvector dipakai untuk kolom `embedding`. Dimensi 768 (nomic-embed-text) — model
//   embedding yang ter-install di Ollama. Jangan campur dengan 1024 (BGE-M3) —
//   ganti model = re-embed semua data + ubah dimensi kolom.
// - Kolom vector direpresentasikan sebagai Unsupported("vector(768)") karena Prisma
//   belum ada native vector type. Query vector dilakukan via $queryRaw.

// `output` sengaja kustom: client ikut ter-ship di dalam package ini supaya
// konsumen (repo web) tidak pernah meresolve instance @prisma/client kedua.
// Path-nya sejajar dari `src/` maupun `dist/`, jadi spesifier `../generated/prisma`
// valid di source (tsx) dan di hasil build.
generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ============================================================
// AUTH & USERS
// ============================================================

enum UserRole {
  jobseeker
  freelancer
  company
  admin
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  username      String?   @unique @db.VarChar(50)
  name          String?   @db.VarChar(255)
  image         String?
  emailVerified DateTime? @map("email_verified")
  role          UserRole  @default(jobseeker)
  onboardedAt   DateTime? @map("onboarded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts                  Account[]
  sessions                  Session[]
  profile                   Profile?
  company                   CompanyProfile?
  skills                    UserSkill[]
  goals                     CareerGoal[]
  paths                     LearningPath[]
  applications              Application[]
  resumes                   Resume[]
  roadmaps                  Roadmap[]
  extensionTokens           ExtensionToken[]
  autofillLogs              AutofillLog[]
  entitlements              Entitlement[]
  jobFeedback               JobFeedback[]
  savedAnswers              SavedAnswer[]
  resumeFile                ResumeFile?
  recommendationImpressions RecommendationImpression[]
  gmailConnection           GmailConnection?
  gmailSuggestions          GmailStatusSuggestion[]
  oauthStates               OAuthState[]

  @@map("users")
}

// NextAuth v5 (Auth.js) adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/**
 * One-time OAuth state bound to the initiating Karirku user.
 */
model OAuthState {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String   @db.VarChar(50)
  stateHash String   @unique @map("state_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt])
  @@map("oauth_states")
}

// ============================================================
// ENTITLEMENTS (fitur premium — spec: 2026-07-06-hunter-premium-foundation-design.md)
// ============================================================

enum EntitlementStatus {
  active
  revoked
}

enum EntitlementSource {
  manual
  payment
}

// Generic per-feature access flag (mis. feature="hunter_auto_apply") —
// bukan tabel Subscription bertingkat, supaya gampang menambah fitur
// premium lain nanti tanpa migration ulang.
model Entitlement {
  id          String            @id @default(cuid())
  userId      String            @map("user_id") @db.Uuid
  feature     String
  status      EntitlementStatus @default(active)
  source      EntitlementSource @default(manual)
  activatedAt DateTime          @default(now()) @map("activated_at")
  expiresAt   DateTime?         @map("expires_at")
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@map("entitlements")
}

// ============================================================
// PROFILE
// ============================================================

model Profile {
  id         String                      @id @default(uuid()) @db.Uuid
  userId     String                      @unique @map("user_id") @db.Uuid
  headline   String?                     @db.Text
  summary    String?                     @db.Text
  skills     String[]                    @db.Text
  experience Json?
  education  Json?
  embedding  Unsupported("vector(768)")?
  updatedAt  DateTime                    @updatedAt @map("updated_at")

  // — data kontak & tautan (dipakai autofill form lamaran) —
  phone             String? @db.VarChar(50)
  city              String? @map("city") @db.VarChar(120)
  country           String? @db.VarChar(120)
  linkedinUrl       String? @map("linkedin_url") @db.Text
  githubUrl         String? @map("github_url") @db.Text
  portfolioUrl      String? @map("portfolio_url") @db.Text
  currentTitle      String? @map("current_title") @db.VarChar(255)
  currentCompany    String? @map("current_company") @db.VarChar(255)
  yearsExperience   Int?    @map("years_experience")
  expectedSalaryIdr Int?    @map("expected_salary_idr")

  // — preferensi kerja (dipakai skor rekomendasi) —
  desiredRoles       String[]        @map("desired_roles") @db.Text
  preferredLocations String[]        @map("preferred_locations") @db.Text
  remoteOnly         Boolean         @default(false) @map("remote_only")
  minSalaryIdr       Int?            @map("min_salary_idr")
  desiredLevel       SeniorityLevel? @map("desired_level")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/**
 * Feedback user terhadap lowongan — sinyal untuk ranking rekomendasi.
 */
model JobFeedback {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  jobId     String            @map("job_id") @db.Uuid
  action    JobFeedbackAction
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, action])
  @@map("job_feedback")
}

enum JobFeedbackAction {
  saved
  hidden
  irrelevant
}

/**
 * Jawaban pertanyaan screening yang pernah di-approve user — dipakai ulang autofill.
 */
model SavedAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  questionKey String   @map("question_key") @db.VarChar(500)
  question    String   @db.Text
  answer      String   @db.Text
  timesUsed   Int      @default(0) @map("times_used")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@map("saved_answers")
}

/**
 * File CV user (PDF/DOC) — diinjeksikan extension ke field upload form lamaran.
 */
model ResumeFile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  data      Bytes
  sizeBytes Int      @map("size_bytes")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resume_files")
}

/**
 * Registry sumber lowongan yang dapat dikelola admin. Provider berupa string
 * agar ATS/career-page baru tidak memerlukan enum migration.
 */
model JobSource {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  provider      String    @db.VarChar(50)
  careersUrl    String    @unique @map("careers_url") @db.Text
  region        String?   @db.VarChar(100)
  enabled       Boolean   @default(true)
  config        Json?
  lastScanAt    DateTime? @map("last_scan_at")
  lastSuccessAt DateTime? @map("last_success_at")
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  jobs Job[]

  @@index([enabled, provider])
  @@map("job_sources")
}

// ============================================================
// COMPANY (sisi employer marketplace — native posting + talent search)
// ============================================================

model CompanyProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String   @db.VarChar(255)
  website   String?  @db.Text
  logoUrl   String?  @map("logo_url") @db.Text
  industry  String?  @db.VarChar(100)
  location  String?  @db.VarChar(255)
  about     String?  @db.Text
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@map("company_profiles")
}

// ============================================================
// JOBS & PROJECTS
// ============================================================

enum JobType {
  fulltime
  parttime
  contract
  remote
  hybrid
  onsite
}

enum SeniorityLevel {
  intern
  junior
  mid
  senior
  lead
  manager
}

model Job {
  id                String                      @id @default(uuid()) @db.Uuid
  source            String                      @db.VarChar(100)
  sourceUrl         String                      @unique @map("source_url") @db.Text
  jobSourceId       String?                     @map("job_source_id") @db.Uuid
  sourceExternalId  String?                     @map("source_external_id") @db.VarChar(255)
  title             String                      @db.VarChar(255)
  company           String?                     @db.VarChar(255)
  // Diisi untuk lowongan native (diposting perusahaan terdaftar). Null = scraped.
  companyProfileId  String?                     @map("company_profile_id") @db.Uuid
  location          String?                     @db.VarChar(255)
  type              JobType?
  level             SeniorityLevel?
  description       String?                     @db.Text
  requirements      String[]                    @db.Text
  skills            String[]                    @db.Text
  salaryMin         Int?                        @map("salary_min")
  salaryMax         Int?                        @map("salary_max")
  currency          String                      @default("IDR") @db.VarChar(10)
  embedding         Unsupported("vector(768)")?
  isActive          Boolean                     @default(true) @map("is_active")
  postedAt          DateTime?                   @map("posted_at")
  scrapedAt         DateTime                    @default(now()) @map("scraped_at")
  lastSeenAt        DateTime                    @default(now()) @map("last_seen_at")
  contentHash       String?                     @map("content_hash") @db.VarChar(64)
  extractionVersion String?                     @map("extraction_version") @db.VarChar(50)
  dataQualityScore  Int                         @default(0) @map("data_quality_score")

  companyProfile            CompanyProfile?            @relation(fields: [companyProfileId], references: [id], onDelete: SetNull)
  jobSource                 JobSource?                 @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  applications              Application[]
  resumes                   Resume[]
  feedback                  JobFeedback[]
  recommendationImpressions RecommendationImpression[]

  @@unique([jobSourceId, sourceExternalId])
  @@index([isActive, postedAt(sort: Desc)])
  @@index([source])
  @@index([companyProfileId])
  @@index([jobSourceId, lastSeenAt(sort: Desc)])
  @@index([contentHash])
  @@map("jobs")
}

model Project {
  id           String                      @id @default(uuid()) @db.Uuid
  source       String                      @db.VarChar(100)
  sourceUrl    String                      @unique @map("source_url") @db.Text
  title        String                      @db.VarChar(255)
  client       String?                     @db.VarChar(255)
  budgetMin    Int?                        @map("budget_min")
  budgetMax    Int?                        @map("budget_max")
  currency     String                      @default("IDR") @db.VarChar(10)
  durationDays Int?                        @map("duration_days")
  skills       String[]                    @db.Text
  description  String?                     @db.Text
  embedding    Unsupported("vector(768)")?
  isActive     Boolean                     @default(true) @map("is_active")
  postedAt     DateTime?                   @map("posted_at")
  scrapedAt    DateTime                    @default(now()) @map("scraped_at")

  @@index([isActive, postedAt(sort: Desc)])
  @@map("projects")
}

// ============================================================
// APPLICATIONS, RESUMES, LEGACY ROADMAP
// ============================================================

enum ApplicationStatus {
  applied
  screened
  interview
  offered
  accepted
  rejected
  ghosted
  withdrawn
}

// native  = dilamar in-platform (lowongan native perusahaan terdaftar)
// external = redirect ke sourceUrl (lowongan scraped, apply di situs asli)
enum ApplicationMode {
  native
  external
}

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  mode        ApplicationMode   @default(native)
  resumeUsed  Json?             @map("resume_used")
  coverLetter String?           @map("cover_letter") @db.Text
  status      ApplicationStatus @default(applied)
  appliedAt   DateTime          @default(now()) @map("applied_at")

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outcome          ApplicationOutcome?
  events           ApplicationEvent[]
  gmailSuggestions GmailStatusSuggestion[]

  @@map("applications")
}

enum ApplicationEventSource {
  manual
  email
  system
}

/**
 * Immutable history used for outcome analysis and recommendation calibration.
 */
model ApplicationEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  applicationId String                 @map("application_id") @db.Uuid
  status        ApplicationStatus
  source        ApplicationEventSource @default(manual)
  confidence    Float?
  note          String?                @db.Text
  emailRefHash  String?                @map("email_ref_hash") @db.VarChar(64)
  occurredAt    DateTime               @default(now()) @map("occurred_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@map("application_events")
}

model GmailConnection {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  email                 String?   @db.VarChar(255)
  encryptedAccessToken  String?   @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at")
  scopes                String[]  @db.Text
  lastSyncedAt          DateTime? @map("last_synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}

enum GmailSuggestionState {
  pending
  confirmed
  dismissed
}

/**
 * Read-only Gmail classification. No full email body is persisted; user must
 * confirm before the application timeline changes.
 */
model GmailStatusSuggestion {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  applicationId   String?              @map("application_id") @db.Uuid
  messageIdHash   String               @map("message_id_hash") @db.VarChar(64)
  senderDomain    String?              @map("sender_domain") @db.VarChar(255)
  subjectPreview  String?              @map("subject_preview") @db.VarChar(200)
  receivedAt      DateTime?            @map("received_at")
  suggestedStatus ApplicationStatus    @map("suggested_status")
  confidence      Float
  state           GmailSuggestionState @default(pending)
  createdAt       DateTime             @default(now()) @map("created_at")
  decidedAt       DateTime?            @map("decided_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, messageIdHash])
  @@index([userId, state, createdAt(sort: Desc)])
  @@map("gmail_status_suggestions")
}

model ApplicationOutcome {
  applicationId String   @id @map("application_id") @db.Uuid
  stageReached  String?  @map("stage_reached") @db.VarChar(50)
  feedback      String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_outcomes")
}

model Resume {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  content   Json
  atsScore  Int?     @map("ats_score")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("resumes")
}

model Roadmap {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  goal      String?  @db.Text
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roadmaps")
}

// ============================================================
// GUIDANCE LOOP TABLES (inti produk)
// ============================================================

model SkillTaxonomy {
  id            String                      @id @default(uuid()) @db.Uuid
  name          String                      @unique @db.VarChar(100)
  slug          String                      @unique @db.VarChar(100)
  category      String?                     @db.VarChar(50)
  aliases       String[]                    @db.Text
  relatedSkills String[]                    @map("related_skills") @db.Uuid
  demandScore   Float?                      @map("demand_score")
  avgSalaryIdr  Int?                        @map("avg_salary_idr")
  embedding     Unsupported("vector(768)")?

  userSkills UserSkill[]

  @@index([category])
  @@map("skill_taxonomy")
}

model UserSkill {
  userId      String    @map("user_id") @db.Uuid
  skillId     String    @map("skill_id") @db.Uuid
  proficiency Int       @default(1) @db.SmallInt
  verified    Boolean   @default(false)
  verifiedBy  String?   @map("verified_by") @db.VarChar(50)
  evidenceUrl String?   @map("evidence_url") @db.Text
  acquiredAt  DateTime? @map("acquired_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill SkillTaxonomy @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

enum GoalStatus {
  active
  paused
  achieved
  abandoned
}

enum CareerTrack {
  fulltime
  freelance
  both
}

model CareerGoal {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  targetRole     String      @map("target_role") @db.VarChar(255)
  targetTrack    CareerTrack @default(fulltime) @map("target_track")
  targetCity     String?     @map("target_city") @db.VarChar(100)
  targetDate     DateTime?   @map("target_date") @db.Date
  why            String?     @db.Text
  weeklyHours    Int?        @map("weekly_hours") @db.SmallInt
  budgetIdr      Int?        @map("budget_idr")
  readinessScore Int         @default(0) @map("readiness_score")
  status         GoalStatus  @default(active)
  createdAt      DateTime    @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paths LearningPath[]

  @@map("career_goals")
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

model Course {
  id            String                      @id @default(uuid()) @db.Uuid
  source        String                      @db.VarChar(50)
  sourceUrl     String                      @unique @map("source_url") @db.Text
  title         String                      @db.VarChar(500)
  provider      String?                     @db.VarChar(255)
  language      String                      @default("id") @db.VarChar(20)
  level         CourseLevel?
  skillsTaught  String[]                    @map("skills_taught") @db.Uuid
  prerequisites String[]                    @db.Uuid
  durationHours Float?                      @map("duration_hours")
  priceIdr      Int                         @default(0) @map("price_idr")
  isPrakerja    Boolean                     @default(false) @map("is_prakerja")
  affiliateUrl  String?                     @map("affiliate_url") @db.Text
  rating        Float?
  enrollment    Int?
  description   String?                     @db.Text
  embedding     Unsupported("vector(768)")?
  scrapedAt     DateTime                    @default(now()) @map("scraped_at")

  @@index([isPrakerja, priceIdr])
  @@index([source])
  @@map("courses")
}

enum PathStatus {
  active
  paused
  completed
  abandoned
}

model LearningPath {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  goalId           String     @map("goal_id") @db.Uuid
  phases           Json
  totalWeeks       Int?       @map("total_weeks")
  progressPct      Float      @default(0) @map("progress_pct")
  readinessScore   Int        @default(0) @map("readiness_score")
  status           PathStatus @default(active)
  generatedByModel String?    @map("generated_by_model") @db.VarChar(50)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       CareerGoal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestones PathMilestone[]

  @@map("learning_paths")
}

enum MilestoneStatus {
  pending
  in_progress
  done
  skipped
}

model PathMilestone {
  id            String          @id @default(uuid()) @db.Uuid
  pathId        String          @map("path_id") @db.Uuid
  weekNumber    Int             @map("week_number")
  title         String          @db.VarChar(255)
  skillIds      String[]        @map("skill_ids") @db.Uuid
  courseIds     String[]        @map("course_ids") @db.Uuid
  projectBrief  String?         @map("project_brief") @db.Text
  status        MilestoneStatus @default(pending)
  submissionUrl String?         @map("submission_url") @db.Text
  aiFeedback    String?         @map("ai_feedback") @db.Text
  completedAt   DateTime?       @map("completed_at")

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([pathId, weekNumber])
  @@map("path_milestones")
}

// ============================================================
// AUTOFILL EXTENSION (spec: 2026-07-06-autofill-extension-design.md)
// ============================================================

// Token ber-scope terbatas untuk browser extension karirku.
// Token asli tidak disimpan — hanya hash SHA-256 (untuk revocation/audit).
model ExtensionToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  scope     String   @default("autofill") @db.VarChar(100)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_tokens")
}

// Log setiap sesi auto-fill — analitik & debugging.
model AutofillLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  url          String   @db.Text
  portal       String?  @db.VarChar(100)
  fieldsTotal  Int      @map("fields_total")
  fieldsFilled Int      @map("fields_filled")
  // adapter | llm | mixed | none
  method       String   @db.VarChar(20)
  // mapped | filled | submitted | error
  status       String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("autofill_logs")
}

model RoleMarketStat {
  id               String   @id @default(uuid()) @db.Uuid
  roleName         String   @map("role_name") @db.VarChar(255)
  city             String   @db.VarChar(100)
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  topSkills        Json     @map("top_skills")
  salaryP25        Int?     @map("salary_p25")
  salaryP50        Int?     @map("salary_p50")
  salaryP75        Int?     @map("salary_p75")
  salaryValues     Int[]    @default([]) @map("salary_values")
  salarySampleSize Int      @default(0) @map("salary_sample_size")
  openPositions    Int?     @map("open_positions")
  sourceCount      Int      @default(0) @map("source_count")
  trend3mo         Float?   @map("trend_3mo")
  topCompanies     String[] @map("top_companies") @db.Text

  @@unique([roleName, city, snapshotDate])
  @@index([roleName])
  @@map("role_market_stats")
}

/**
 * Sampled ranking observation. V1 stays displayed while V2 runs in shadow
 * mode; downstream feedback and outcomes can be joined by user/job/time.
 */
model RecommendationImpression {
  id               String    @id @default(uuid()) @db.Uuid
  batchId          String    @map("batch_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  scoreV1          Int       @map("score_v1")
  scoreV2          Int       @map("score_v2")
  rankV1           Int       @map("rank_v1")
  rankV2           Int       @map("rank_v2")
  confidenceV2     Float     @map("confidence_v2")
  componentsV2     Json      @map("components_v2")
  displayedVersion String    @default("v1") @map("displayed_version") @db.VarChar(20)
  scoreVersion     String    @default("v2-shadow-1") @map("score_version") @db.VarChar(50)
  surface          String    @default("legacy") @db.VarChar(50)
  queryHash        String    @default("legacy") @map("query_hash") @db.VarChar(64)
  windowStart      DateTime  @default(now()) @map("window_start")
  displayed        Boolean   @default(true)
  openedAt         DateTime? @map("opened_at")
  savedAt          DateTime? @map("saved_at")
  hiddenAt         DateTime? @map("hidden_at")
  irrelevantAt     DateTime? @map("irrelevant_at")
  appliedAt        DateTime? @map("applied_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, surface, queryHash, windowStart])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([batchId])
  @@map("recommendation_impressions")
}
