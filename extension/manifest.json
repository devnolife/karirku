{
  "manifest_version": 3,
  "name": "Karirku Auto-Fill",
  "version": "0.1.0",
  "description": "Isi form lamaran kerja otomatis dari profil karirku Anda. AI mengisi, Anda review dan submit sendiri.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3030/*", "https://*.karirku.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Karirku Auto-Fill"
  }
}
