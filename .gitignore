# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docker volumes
/.docker/

# ai / scraper
/storage/
/.crawlee/

# Hunter engine local data
/data/
/hunter/secrets/

# editor
.vscode/
.idea/
*.swp

# session/agent planning artifacts
/CLAUDE.md
/AGENTS.md

/src/generated/prisma

# brainstorm visual companion sessions
.superpowers/

# Agent skills (local only, do not push)
.agents/
skills-lock.json

# graphify knowledge-graph cache (generated, local only)
/graphify-out/

# Python bytecode (generated)
__pycache__/
*.py[cod]
